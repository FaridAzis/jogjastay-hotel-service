  "nonEquivalences": [
    "city=Kota Yogyakarta tidak sama dengan Provinsi DIY",
    "hotelId tidak sama dengan destination_id walaupun nilainya sama",
    "checkIn tidak sama dengan visit_date",
    "guests tidak selalu sama dengan qty",
    "pricePerNight tidak sama dengan unit_price tiket",
    "confirmed tidak sama dengan paid",
    "hotel cancelled tidak sama dengan wisata refunded"
  ]
