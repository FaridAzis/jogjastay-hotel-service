  "statusMappings": {
    "hotelBooking": {
      "confirmed": "reserved",
      "checked_in": "in_progress",
      "checked_out": "completed",
      "cancelled": "cancelled"
    },
    "hotelPayment": {
      "unpaid": "unpaid",
      "paid": "paid",
      "refunded": "refunded",
      "partially_refunded": "partially_refunded"
    },
    "wisataBooking": {
      "PENDING": "awaiting_payment",
      "PAID": "reserved",
      "REFUNDED": "refunded",
      "EXPIRED": "expired"
    },
    "wisataPayment": {
      "PENDING": "unpaid",
      "PAID": "paid",
      "REFUNDED": "refunded",
      "EXPIRED": "expired"
